<file path="server.js">
const express = require('express');
const { exec } = require('child_process');
const path = require('path');
const fs = require('fs');
const app = express();

// Railway asigna el puerto automáticamente
const PORT = process.env.PORT || 3000;

app.use(express.json());
app.use(express.static(path.join(__dirname, 'dashboard')));

// Servir productos.json
app.get('/api/productos', (req, res) => {
    try {
        const datos = JSON.parse(fs.readFileSync(path.join(__dirname, 'productos.json'), 'utf-8'));
        res.json(datos);
    } catch (error) {
        res.status(500).json({ error: 'Error al leer productos' });
    }
});

// Guardar productos.json
app.post('/api/productos', (req, res) => {
    try {
        fs.writeFileSync(path.join(__dirname, 'productos.json'), JSON.stringify(req.body, null, 2));
        res.json({ success: true, mensaje: '✅ Productos guardados' });
    } catch (error) {
        res.status(500).json({ error: 'Error al guardar' });
    }
});

// Ruta principal → dashboard
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'dashboard', 'index.html'));
});

// Estado
app.get('/api/estado', (req, res) => {
    res.json({ 
        online: true,
        timestamp: new Date().toISOString()
    });
});

app.listen(PORT, () => {
    console.log(`✅ Servidor en puerto ${PORT}`);
});
