    color: var(--primary);
    display: block;
    margin-bottom: 5px;
}

/* ========== TOAST ========== */
.toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--success);
    color: white;
    padding: 15px 25px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    z-index: 300;
    animation: slideUp 0.3s ease;
    font-weight: 600;
    font-size: 14px;
    max-width: 350px;
}

/* ========== EMPTY STATE ========== */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
    grid-column: 1 / -1;
}

.empty-state .icon {
    font-size: 60px;
    margin-bottom: 15px;
    opacity: 0.6;
}

.empty-state p {
    font-size: 16px;
    margin-bottom: 5px;
}

.empty-state small {
    color: var(--text-muted);
}

/* ========== ANIMACIONES ========== */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(100px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
        padding: 15px;
    }

    .productos-grid {
        grid-template-columns: 1fr;
        padding: 0 15px 15px;
    }

    .header {
        padding: 15px;
        flex-direction: column;
        gap: 10px;
    }

    .header-actions {
        width: 100%;
        justify-content: center;
    }

    .toolbar {
        padding: 0 15px 15px;
        flex-direction: column;
    }

    .search-box {
        width: 100%;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .modal {
        padding: 20px;
        margin: 10px;
    }

    .toast {
        left: 20px;
        right: 20px;
        bottom: 20px;
        text-align: center;
    }
}

@media (max-width: 480px) {
    .stats {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .stat-card .number {
        font-size: 24px;
    }

    .btn {
        padding: 6px 12px;
        font-size: 12px;
    }
}
